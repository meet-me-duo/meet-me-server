{
  "description": "Load meet-me-server development guardrails into Codex sessions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.py\"",
            "timeout": 5,
            "statusMessage": "Loading meet-me-server guidance",
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/tdd_guard.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/tdd_guard.py\"",
            "timeout": 600,
            "statusMessage": "Running the pre-commit TDD quality gate"
          }
        ]
      }
    ]
  }
}
