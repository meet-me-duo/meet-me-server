# Copy only the settings you need to .env.local and enter real values there.
# Never put real secret values in this example, Git, chat, Issue, PR, or logs.
# See docs/USER_INTERVENTION.md before creating or registering credentials.

# Active local integration
GEMINI_API_KEY=

# Database settings. The checked-in defaults are local-development only.
DATABASE_URL=jdbc:postgresql://localhost:5432/meetme
DATABASE_USERNAME=meetme
DATABASE_PASSWORD=
DATABASE_MAX_POOL_SIZE=10

# Redis reliability, abuse prevention, and local metrics settings.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2s
REDIS_SSL_ENABLED=false
REDIS_CONSUMER_NAME=meet-me-local
REDIS_PENDING_MIN_IDLE=2m
OUTBOX_RECOVERY_AGE=2m
REDIS_DLQ_RETENTION=30d
REDIS_DLQ_MAX_ENTRIES=10000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE_LIMIT=10
RATE_LIMIT_CREATE_WINDOW=1h
RATE_LIMIT_JOIN_LIMIT=30
RATE_LIMIT_JOIN_WINDOW=1h
RATE_LIMIT_SUBMISSION_LIMIT=30
RATE_LIMIT_SUBMISSION_WINDOW=1m
RATE_LIMIT_HOST_COMMAND_LIMIT=5
RATE_LIMIT_HOST_COMMAND_WINDOW=1m
ROOM_DATA_RETENTION=30d
AI_COST_USD_TO_KRW=1500
AI_COST_MAXIMUM_KRW_PER_MEETING=10
MANAGEMENT_PORT=9090
MANAGEMENT_ADDRESS=127.0.0.1

# Post-MVP Grafana Cloud credentials are intentionally absent.
# Alloy, Grafana Cloud Metrics/Loki, dashboards, and alerting are not part of the submission MVP.

# Post-MVP OAuth credentials. Do not create them for the Wanted submission MVP.
# Follow docs/USER_INTERVENTION.md when social login work resumes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
