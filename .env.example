# Copy only the settings you need to .env.local and enter real values there.
# Never put real secret values in this example, Git, chat, Issue, PR, or logs.
# See docs/USER_INTERVENTION.md before creating or registering credentials.

# Active local integration
GEMINI_API_KEY=
# Pre-submit Gemini checks stay OFF. Enabling requires a separate cost-policy and real-API decision.
# Documented fixed profile and synthetic tests do not verify live usage or billing.
MEETME_PRECHECK_PROVIDER_ENABLED=false
OPENAI_API_KEY=

# Database settings. The checked-in defaults are local-development only.
DATABASE_URL=jdbc:postgresql://localhost:5432/meetme
DATABASE_USERNAME=meetme
DATABASE_PASSWORD=
DATABASE_MAX_POOL_SIZE=10

# Redis reliability, abuse prevention, and local metrics settings.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2s
REDIS_SSL_ENABLED=false
REDIS_CONSUMER_NAME=meet-me-local
REDIS_PENDING_MIN_IDLE=2m
OUTBOX_RECOVERY_AGE=2m
REDIS_DLQ_RETENTION=30d
REDIS_DLQ_MAX_ENTRIES=10000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE_LIMIT=10
RATE_LIMIT_CREATE_WINDOW=1h
RATE_LIMIT_JOIN_LIMIT=30
RATE_LIMIT_JOIN_WINDOW=1h
RATE_LIMIT_SUBMISSION_LIMIT=30
RATE_LIMIT_SUBMISSION_WINDOW=1m
RATE_LIMIT_HOST_COMMAND_LIMIT=5
RATE_LIMIT_HOST_COMMAND_WINDOW=1m
ROOM_DATA_RETENTION=30d
AI_COST_USD_TO_KRW=1500
AI_COST_MAXIMUM_KRW_PER_MEETING=10
MANAGEMENT_PORT=9090
MANAGEMENT_ADDRESS=127.0.0.1

# Post-MVP Grafana Cloud credentials are intentionally absent.
# Alloy, Grafana Cloud Metrics/Loki, dashboards, and alerting are not part of the submission MVP.

# Issue #109 login-only OAuth. Existing public app setup is complete.
# Runtime credential/key delivery and real login remain separate user actions.
# See docs/ISSUE_109_OAUTH_SETUP.md; never commit or print actual secrets.
# Production uses runtime-auth-mode and typed parameters documented in ISSUE_107_EXTERNAL_READINESS_RUNBOOK.md.
# Compose mounts AUTH_KEYS_DIRECTORY (default /opt/meet-me/auth) read-only at /run/meetme-auth.
# The production renderer supplies the two fixed file paths; keep local paths empty until configured.
APP_ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback
AUTH_SIGNING_KEY_ID=
AUTH_SIGNING_PRIVATE_KEY_PATH=
AUTH_VERIFICATION_JWKS_PATH=
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=meetme-web
AUTH_WEB_CALLBACK_URI=http://localhost:5173/auth/callback
