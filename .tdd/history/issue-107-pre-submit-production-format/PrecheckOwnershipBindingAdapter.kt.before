package com.meetme.server.precheck.adapter.output.security

import com.meetme.server.meetingroom.application.port.input.RoomLifecycleErrorCode
import com.meetme.server.meetingroom.application.port.input.RoomLifecycleException
import com.meetme.server.participant.application.port.output.GuestOwnershipProofPort
import com.meetme.server.participant.application.port.output.GuestReaccessRepository
import com.meetme.server.participant.application.port.output.GuestSessionRepository
import com.meetme.server.participant.domain.Participant
import com.meetme.server.precheck.application.port.output.PrecheckOwnershipBindingPort
import com.meetme.server.shared.domain.GuestSessionId
import org.springframework.stereotype.Component
import java.time.Instant
import java.util.UUID

@Component
class PrecheckOwnershipBindingAdapter(
    private val proofs: GuestOwnershipProofPort,
    private val sessions: GuestSessionRepository,
    private val grants: GuestReaccessRepository,
) : PrecheckOwnershipBindingPort {
    override fun capture(
        participant: Participant,
        rawCredential: String?,
    ): String {
        participant.userId?.let { return "A|$it" }
        val prefix = "G|${requireNotNull(participant.guestSessionId).value}"
        val proof =
            proofs.resolve(participant.roomId, rawCredential)
                ?: throw RoomLifecycleException(RoomLifecycleErrorCode.GUEST_SESSION_INVALID)
        val provenance =
            proof.provenance
                ?: throw RoomLifecycleException(RoomLifecycleErrorCode.GUEST_PROOF_INSUFFICIENT)
        return "$prefix|${provenance.sessionId.value}|${provenance.validUntil.toEpochMilli()}|${provenance.grantGeneration ?: ""}|${proof.level.name}"
    }

    override fun isActive(
        participant: Participant,
        binding: String,
        at: Instant,
    ): Boolean {
        val parts = binding.split('|')
        if (participant.userId != null) return binding == "A|${participant.userId}"
        if (parts.size < 2 || parts[0] != "G" || parts[1] != participant.guestSessionId?.value.toString()) return false
        if (parts.size != 6) return false
        return runCatching {
            val sessionId = GuestSessionId(UUID.fromString(parts[2]))
            if (at.toEpochMilli() >= parts[3].toLong() || sessions.findById(sessionId)?.isActive(at) != true) return false
            if (parts[4].isEmpty()) return sessionId == participant.guestSessionId
            val grant = grants.grant(participant.roomId, sessionId)
            grant != null &&
                grant.participantId == participant.id &&
                grant.generation?.toString() == parts[4] &&
                grant.level.name == parts[5] &&
                at < grant.expiresAt
        }.getOrDefault(false)
    }
}
