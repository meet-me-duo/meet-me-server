import com.meetme.server.precheck.adapter.output.classification.AmbiguityClassificationContract;
import com.meetme.server.precheck.application.port.output.AmbiguityClassificationRequest;
import tools.jackson.databind.json.JsonMapper;
import okhttp3.*;
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.nio.file.attribute.PosixFilePermissions;
import java.security.MessageDigest;
import java.time.*;
import java.util.*;
import java.util.concurrent.*;
import java.util.concurrent.atomic.*;
import java.util.function.LongSupplier;

/** Independent public-contract oracle. All text/context/keys/cost evidence are explicitly synthetic. */
public final class Issue130SyntheticContractTest {
    static final JsonMapper JSON=JsonMapper.builder().build();
    static final Path REPO=Path.of(System.getProperty("issue130.sourceRoot")).toAbsolutePath();
    static final String KEY="synthetic-issue130-key-MUST-NOT-LEAK";
    static final Instant DATE=Instant.parse("2026-10-18T03:00:00Z");
    static final String[] SOURCE_FILES={
        "src/main/kotlin/com/meetme/server/precheck/adapter/output/classification/AmbiguityClassificationContract.kt",
        "src/main/kotlin/com/meetme/server/precheck/adapter/output/classification/OpenAiAmbiguityClassifier.kt",
        "src/main/kotlin/com/meetme/server/precheck/adapter/output/classification/AmbiguityClassifierOptions.kt",
        "src/main/kotlin/com/meetme/server/precheck/adapter/output/provider/TwoStagePreSubmissionCheckProvider.kt"
    };
    @FunctionalInterface interface Checked {void run()throws Exception;}
    static final Map<String,Checked> TESTS=new LinkedHashMap<>();
    static void test(String name,Checked body){TESTS.put(name,body);}
    static void check(boolean value,String message){if(!value)throw new AssertionError(message);}
    static void eq(Object expected,Object actual,String message){check(Objects.equals(expected,actual),message);}
    static String sha(byte[] bytes)throws Exception{return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));}
    static String sha(Path path)throws Exception{return sha(Files.readAllBytes(path));}
    static Map<String,Object> map(Object object){return (Map<String,Object>)object;}
    static List<Map<String,Object>> results(Map<String,Object> result){return (List<Map<String,Object>>)result.get("results");}
    static long number(Object value){return ((Number)value).longValue();}
    static Path privateRoot()throws Exception{Path p=Files.createTempDirectory("issue130-independent-synthetic-");Files.setPosixFilePermissions(p,PosixFilePermissions.fromString("rwx------"));return p;}
    static void write(Path path,Object value)throws Exception{Files.write(path,JSON.writeValueAsBytes(value),StandardOpenOption.CREATE,StandardOpenOption.TRUNCATE_EXISTING);Files.setPosixFilePermissions(path,PosixFilePermissions.fromString("rw-------"));}
    static Map<String,Object> input(String raw){Map<String,Object> m=new LinkedHashMap<>();m.put("raw_text",raw);m.put("reference_at",DATE.toString());m.put("time_zone","Asia/Seoul");m.put("locale","ko-KR");m.put("search_start_date","2026-10-18");m.put("search_end_date","2026-10-31");return m;}
    static byte[] productionWire(String raw){return new AmbiguityClassificationContract(JSON).requestBytes(new AmbiguityClassificationRequest(raw,DATE,ZoneId.of("Asia/Seoul"),"ko-KR",LocalDate.of(2026,10,18),LocalDate.of(2026,10,31),Duration.ofSeconds(15),null));}
    static String body(String choice,String confidence,boolean complete,long input,long output){
        Map<String,Object> answer=new LinkedHashMap<>();answer.put("type","choice");answer.put("name","material_ambiguity");answer.put("choice",choice);answer.put("confidence",Double.parseDouble(confidence));
        answer.put("probabilities",List.of(Map.of("value","CLEAR","probability",choice.equals("CLEAR")?0.8:0.1),Map.of("value","NEEDS_REVIEW","probability",choice.equals("NEEDS_REVIEW")?0.8:0.1),Map.of("value","INDETERMINATE","probability",choice.equals("INDETERMINATE")?0.8:0.1)));
        Map<String,Object> envelope=new LinkedHashMap<>();envelope.put("model","gpt-6-luna");envelope.put("answers",List.of(answer));
        if(complete)envelope.put("usage",Map.of("input_tokens",input,"input_tokens_details",Map.of("cached_tokens",0,"cache_write_tokens",0),"output_tokens",output,"output_tokens_details",Map.of("reasoning_tokens",0),"total_tokens",input+output));
        return JSON.writeValueAsString(envelope);
    }
    static final String CLEAR=body("CLEAR","0.9",true,137,7);
    static String refusal(){Map<String,Object> m=map(JSON.readValue(CLEAR,Map.class));m.put("answers",List.of(Map.of("name","material_ambiguity","type","refusal")));return JSON.writeValueAsString(m);}
    static void safeCode(Issue130RepresentativeDecisionsCli.EvaluationException e){check(e.code()!=null&&e.code().matches("[A-Z][A-Z0-9_]{0,63}"),"bounded failure code");check(!String.valueOf(e).contains(KEY),"credential-free failure");}
    static void rejected(Checked work)throws Exception{try{work.run();throw new AssertionError("invalid operation must be rejected");}catch(Issue130RepresentativeDecisionsCli.EvaluationException e){safeCode(e);}}
    static void prepRejected(Map<String,Object> data)throws Exception{Path root=privateRoot(),in=root.resolve("input.json"),out=root.resolve("wire.json");write(in,data);rejected(()->Issue130RepresentativeDecisionsCli.prepareOne(in,out));check(!Files.exists(out),"invalid prep creates no wire");}
    static void assertPrivate(Path p)throws Exception{eq(PosixFilePermissions.fromString("rw-------"),Files.getPosixFilePermissions(p),"private file mode0600");}
    static void noLeaks(Object value)throws Exception{String s=JSON.writeValueAsString(value);check(!s.contains(KEY)&&!s.contains("SYNTHETIC_PRIVATE_RAW_")&&!s.contains(REPO.toString()),"safe report excludes raw/key/sourcepath");}

    static final class Fixture implements AutoCloseable {
        final Path root=privateRoot(),index=root.resolve("prepared-index.json"),plan=root.resolve("plan.json"),output=root.resolve("output");
        final List<Map<String,Object>> records=new ArrayList<>();final Map<String,Object> config=new LinkedHashMap<>();
        Issue130SyntheticTlsProxy proxy;
        LongSupplier nano=System::nanoTime;
        OkHttpClient clientOverride;
        Clock clock=Clock.fixed(DATE,ZoneOffset.UTC);
        Fixture()throws Exception{
            Files.createDirectory(output,PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rwx------")));
            for(int i=0;i<16;i++){Path wire=root.resolve(String.format("wire-%02d.json",i+1));byte[] bytes=productionWire("SYNTHETIC_PRIVATE_RAW_"+i+" 주말 아무 때나 가능");Files.write(wire,bytes);Files.setPosixFilePermissions(wire,PosixFilePermissions.fromString("rw-------"));records.add(new LinkedHashMap<>(Map.of("opaque_call_id","synthetic-opaque-"+i,"request_path",wire.toString(),"request_sha256",sha(bytes),"request_bytes",bytes.length)));}
            write(index,Map.of("status","WIRES_PREPARED_NOT_EXECUTION","records",records));
            Map<String,String> source=new LinkedHashMap<>(),runtime=new LinkedHashMap<>();for(String rel:SOURCE_FILES){source.put(rel,sha(REPO.resolve(rel)));runtime.put(REPO.resolve(rel).toString(),sha(REPO.resolve(rel)));}
            for(String rel:List.of("evaluation/issue130/Issue130RepresentativeDecisionsCli.java","evaluation/issue130/run_representative_decisions.py"))runtime.put(REPO.resolve(rel).toString(),sha(REPO.resolve(rel)));
            Path cp=root.resolve("runtime.classpath");Files.writeString(cp,System.getProperty("java.class.path"));runtime.put(cp.toString(),sha(cp));
            Path manifest=root.resolve("source-manifest.json");write(manifest,Map.of("files",source));Path review=root.resolve("synthetic-cost-review.json");write(review,Map.of("status","SYNTHETIC_REVIEW_PROXY_ACCEPTED_NOT_INVOICE_CAP"));
            config.put("outputDirectory",output.toString());config.put("workItem","issue130-representative-decisions");config.put("suiteId",UUID.randomUUID().toString());config.put("sourceRoot",REPO.toString());
            config.put("sourceRevision",new String(new ProcessBuilder("git","-C",REPO.toString(),"rev-parse","HEAD").start().getInputStream().readAllBytes(),StandardCharsets.UTF_8).trim());
            config.put("sourceManifest",Map.of("path",manifest.toString(),"sha256",sha(manifest)));config.put("runtimeFiles",runtime);config.put("preparedIndexSha256",sha(index));
            config.put("caseCount",16);config.put("endpoint","https://api.openai.com/v1/decisions");config.put("model","gpt-6-luna");config.put("minimumConfidence",0.8);config.put("operatingConfigurationChanged",false);
            config.put("perCallSeconds",15);config.put("suiteSeconds",300);config.put("concurrency",1);config.put("maximumHttpAttempts",16);config.put("countCalls",0);config.put("generationCalls",0);config.put("automaticRetries",0);config.put("redirects",0);config.put("fallbacks",0);config.put("requestByteCap",16384);config.put("responseByteCap",16384);
            Map<String,Object> cost=new LinkedHashMap<>();cost.put("inputUsdPerMillion","0.10");cost.put("inputTokenProxy",65536);cost.put("margin","2.2");cost.put("perCallReservedUsd","0.01441792");cost.put("priorHeldUsd","1.33185536");cost.put("maximumNewReservedUsd","0.23068672");cost.put("maximumCumulativeReservedUsd","1.56254208");cost.put("approvedAggregateUsd","2.00");cost.put("officialInvoiceHardCapProven",false);cost.put("review",Map.of("path",review.toString(),"sha256",sha(review)));config.put("costProfile",cost);seal();
        }
        void seal()throws Exception{write(plan,config);}
        Map<String,String> environment()throws Exception{return Map.of("OPENAI_API_KEY",KEY,"ISSUE130_FROZEN_PLAN_SHA256",sha(plan),"ISSUE130_EXECUTE_FROZEN",sha(plan),"ISSUE130_SUITE_REMAINING_MILLIS","300000");}
        Issue130SyntheticTlsProxy network()throws Exception{if(proxy==null)proxy=new Issue130SyntheticTlsProxy(root);return proxy;}
        Map<String,Object> run()throws Exception{return run(environment());}
        Map<String,Object> run(Map<String,String> env)throws Exception{return Issue130RepresentativeDecisionsCli.runSuite(plan,index,output,new Issue130RepresentativeDecisionsCli.Dependencies(clientOverride==null?network().client():clientOverride,nano,clock,env));}
        void replies(String body)throws Exception{for(int i=0;i<16;i++)network().enqueue(Issue130SyntheticTlsProxy.Reply.json(200,body));}
        void failClosed()throws Exception{rejected(()->run());eq(0,network().sent.size(),"invalid frozen setup emits zero requests");}
        public void close()throws Exception{if(proxy!=null)proxy.close();}
    }
    static void suiteShape(Map<String,Object> result,int calls)throws Exception{eq((long)calls,number(result.get("physicalDecisionsCalls")),"physical A call denominator");eq(0L,number(result.get("physicalGenerationCalls")),"B calls zero");eq(0L,number(result.get("countCalls")),"Count calls zero");eq(16,results(result).size(),"all fixed case denominators retained");noLeaks(result);}
    static void stoppedAfterOne(Issue130SyntheticTlsProxy.Reply reply,String outcome)throws Exception{
        try(Fixture f=new Fixture()){f.network().enqueue(reply);Map<String,Object> r=f.run();suiteShape(r,1);eq("STOPPED",r.get("status"),"technical failure stops suite");eq(outcome,results(r).get(0).get("outcome"),"first outcome");for(Map<String,Object> rest:results(r).subList(1,16))eq("NOT_RUN_AFTER_SUITE_STOP",rest.get("outcome"),"remaining cases explicitly not run");eq(1,f.proxy.sent.size(),"one physical POST");check(f.proxy.connections.get()<=1,"no hidden transport reconnection");}
    }
    static {
        test("N01_local_TLS_proxy_actual_production_classifier_control",()->{Path root=privateRoot();try(Issue130SyntheticTlsProxy proxy=new Issue130SyntheticTlsProxy(root)){proxy.enqueue(Issue130SyntheticTlsProxy.Reply.json(200,CLEAR));var classifier=new com.meetme.server.precheck.adapter.output.classification.OpenAiAmbiguityClassifier(KEY,JSON,new com.meetme.server.precheck.adapter.output.classification.AmbiguityClassifierOptions(java.net.URI.create("https://api.openai.com/v1/decisions"),true,0.8),proxy.client(),null,null);var result=classifier.classify(new AmbiguityClassificationRequest("synthetic positive control",DATE,ZoneId.of("Asia/Seoul"),"ko-KR",LocalDate.of(2026,10,18),LocalDate.of(2026,10,31),Duration.ofSeconds(2),null));eq("CLEAR",result.getAssessment().name(),"actual production canonical parser through loopbackTLS");eq(137L,result.getInputTokens(),"known usage control");eq(1,proxy.sent.size(),"real physical POST observed");check(proxy.fixtureFailures.isEmpty(),"mockTLS fixture fully exercised");}});
        test("P01_exact_production_serializer_and_whitespace",()->{Path root=privateRoot(),in=root.resolve("in.json"),out=root.resolve("wire.json");String raw="  synthetic 주말 아무 때나\n다른 조건 보존  ";write(in,input(raw));Map<String,Object> r;Issue130SyntheticNetworkGuard.denyKeyReads=true;try{r=Issue130RepresentativeDecisionsCli.prepareOne(in,out);}finally{Issue130SyntheticNetworkGuard.denyKeyReads=false;}eq(Set.of("prepared","requestBytes","requestSha256","model"),r.keySet(),"safe metadata only");eq(true,r.get("prepared"),"prep success");check(Arrays.equals(productionWire(raw),Files.readAllBytes(out)),"canonical production bytes exact");eq(sha(out),r.get("requestSha256"),"wire fingerprint");assertPrivate(out);noLeaks(r);});
        test("P02_unicode_500_codepoints",()->{Path root=privateRoot(),in=root.resolve("in.json"),out=root.resolve("wire.json");String raw="😀".repeat(500);write(in,input(raw));Issue130RepresentativeDecisionsCli.prepareOne(in,out);check(Arrays.equals(productionWire(raw),Files.readAllBytes(out)),"500 codepoints accepted unchanged");});
        test("P03_reject_501",()->prepRejected(input("가".repeat(501))));
        test("P04_reject_NUL",()->prepRejected(input("synthetic\u0000private")));
        test("P05_reject_extra_gold_field",()->{Map<String,Object> m=input("synthetic");m.put("gold","CLEAR");prepRejected(m);});
        test("P06_reject_missing_locale",()->{Map<String,Object> m=input("synthetic");m.remove("locale");prepRejected(m);});
        test("P07_reject_wrong_type",()->{Map<String,Object> m=input("synthetic");m.put("raw_text",7);prepRejected(m);});
        test("P08_reject_invalid_context",()->{for(String key:List.of("reference_at","time_zone","locale","search_start_date","search_end_date")){Map<String,Object> m=input("synthetic");m.put(key,"invalid_!_synthetic");prepRejected(m);}});
        test("P09_existing_output_unchanged",()->{Path root=privateRoot(),in=root.resolve("in.json"),out=root.resolve("wire.json");write(in,input("synthetic"));Files.writeString(out,"existing-synthetic");rejected(()->Issue130RepresentativeDecisionsCli.prepareOne(in,out));eq("existing-synthetic",Files.readString(out),"CREATE_NEW preserves old bytes");});
        test("P10_symlink_output_unchanged",()->{Path root=privateRoot(),in=root.resolve("in.json"),real=root.resolve("real"),link=root.resolve("wire.json");write(in,input("synthetic"));Files.writeString(real,"existing-synthetic");Files.createSymbolicLink(link,real);rejected(()->Issue130RepresentativeDecisionsCli.prepareOne(in,link));eq("existing-synthetic",Files.readString(real),"symlink target unchanged");});
        test("P11_symlink_ancestor_rejected",()->{Path root=privateRoot(),in=root.resolve("in.json"),real=Files.createDirectory(root.resolve("real")),link=root.resolve("linked");write(in,input("synthetic"));Files.createSymbolicLink(link,real);rejected(()->Issue130RepresentativeDecisionsCli.prepareOne(in,link.resolve("wire.json")));check(!Files.exists(real.resolve("wire.json")),"ancestor symlink prevents write");});
        test("P12_duplicate_input_key_rejected",()->{Path root=privateRoot(),in=root.resolve("in.json"),out=root.resolve("wire.json");String s=JSON.writeValueAsString(input("synthetic"));Files.writeString(in,s.substring(0,s.length()-1)+",\"raw_text\":\"changed\"}");rejected(()->Issue130RepresentativeDecisionsCli.prepareOne(in,out));check(!Files.exists(out),"duplicate input key fails closed");});
        test("P13_prepare_index_preserves_16_order",()->prepareIndex(false));
        test("P14_prepare_index_duplicate_ID_rejected",()->prepareIndex(true));
        test("P17_reverse_search_dates_rejected",()->{Map<String,Object> data=input("synthetic");data.put("search_end_date","2026-10-17");prepRejected(data);});
        test("P18_whole_wire_16KiB_includes_context",()->{Map<String,Object> data=input("synthetic");data.put("locale","en-x-"+"abcd-".repeat(3500)+"end");prepRejected(data);});
        test("P15_actual_CLI_prepare_stdout_private",()->{Path root=privateRoot(),in=root.resolve("input.json"),out=root.resolve("wire.json");String raw="SYNTHETIC_PRIVATE_RAW_CLI";write(in,input(raw));ProcessBuilder b=new ProcessBuilder(Path.of(System.getProperty("java.home"),"bin","java").toString(),"-Djava.security.manager=Issue130SyntheticNetworkGuard","-cp",System.getProperty("java.class.path"),"Issue130RepresentativeDecisionsCli","prepare-one",in.toString(),out.toString());b.environment().put("OPENAI_API_KEY",KEY);b.environment().put("GEMINI_API_KEY","");Process child=b.start();String stdout=new String(child.getInputStream().readAllBytes(),StandardCharsets.UTF_8),stderr=new String(child.getErrorStream().readAllBytes(),StandardCharsets.UTF_8);check(child.waitFor(10,TimeUnit.SECONDS),"prep CLI bounded lifetime");eq(0,child.exitValue(),"actual CLI prep success");Map<String,Object> result=map(JSON.readValue(stdout,Map.class));eq(Set.of("prepared","requestBytes","requestSha256","model"),result.keySet(),"stdout safe metadata only");check(!(stdout+stderr).contains(raw)&&!(stdout+stderr).contains(root.toString())&&!(stdout+stderr).contains(KEY),"CLI no private raw/key/path");});
        test("P16_actual_CLI_failure_no_raw_path_stack",()->{Path root=privateRoot(),in=root.resolve("input.json"),out=root.resolve("wire.json");String raw="SYNTHETIC_PRIVATE_RAW_CLI_FAILURE";Map<String,Object> data=input(raw);data.put("gold","CLEAR");write(in,data);Process child=new ProcessBuilder(Path.of(System.getProperty("java.home"),"bin","java").toString(),"-Djava.security.manager=Issue130SyntheticNetworkGuard","-cp",System.getProperty("java.class.path"),"Issue130RepresentativeDecisionsCli","prepare-one",in.toString(),out.toString()).start();String stdout=new String(child.getInputStream().readAllBytes(),StandardCharsets.UTF_8),stderr=new String(child.getErrorStream().readAllBytes(),StandardCharsets.UTF_8);check(child.waitFor(10,TimeUnit.SECONDS),"invalid CLI bounded lifetime");check(child.exitValue()!=0,"invalid CLI rejected");check(!(stdout+stderr).contains(raw)&&!(stdout+stderr).contains(root.toString())&&!(stdout+stderr).contains("at Issue130RepresentativeDecisionsCli"),"bounded CLI failure no raw/path/stack");check(!Files.exists(out),"invalid CLI no output");});
        test("R01_CLEAR16_real_canonical_transport",()->{try(Fixture f=new Fixture()){f.replies(CLEAR);Map<String,Object> r=f.run();suiteShape(r,16);eq("COMPLETED",r.get("status"),"clear suite complete");eq(16,f.proxy.sent.size(),"exact16 POSTs");eq(1,f.proxy.maximumActive.get(),"serial1");for(int i=0;i<16;i++){Map<String,Object> c=results(r).get(i);eq("CLEAR_STOP",c.get("outcome"),"actual TwoStage CLEAR");eq("CLEAR",c.get("rawChoice"),"raw choice retained");eq("CLEAR",c.get("assessment"),"normalized assessment");eq(137L,number(c.get("inputTokens")),"known input preserved");eq(7L,number(c.get("outputTokens")),"nonzero output preserved");eq(true,c.get("usageComplete"),"complete usage");eq(0L,number(c.get("logicalBProbeEntries")),"CLEAR no B entry");Issue130SyntheticTlsProxy.Sent sent=f.proxy.sent.get(i);eq("POST",sent.method(),"POST only");eq("/v1/decisions",sent.path(),"canonical path");eq("api.openai.com",sent.headers().get("host"),"canonical host");eq("Bearer "+KEY,sent.headers().get("authorization"),"synthetic bearer passed unchanged");check(Arrays.equals(Files.readAllBytes(Path.of((String)f.records.get(i).get("request_path"))),sent.body()),"frozen wire unchanged");assertPrivate(f.output.resolve(String.format("%02d-result.json",i+1)));assertPrivate(f.output.resolve(String.format("%02d-response.raw.json",i+1)));}assertPrivate(f.output.resolve(".suite-consumed.json"));assertPrivate(f.output.resolve("suite-result.json"));check(f.proxy.fixtureFailures.isEmpty(),"TLS fixture no unexpected operation");}});
        test("R02_review_routes_B_probe_no_real_B",()->normalRoute("NEEDS_REVIEW","0.9","NEEDS_REVIEW",null));
        test("R03_low_confidence_raw_CLEAR_is_normalized_hold",()->normalRoute("CLEAR","0.79","INDETERMINATE","LOW_CONFIDENCE"));
        test("R04_model_uncertain_routes_B_probe",()->normalRoute("INDETERMINATE","0.9","INDETERMINATE","MODEL_UNCERTAIN"));
        test("R05_refusal_safe_STOP",()->stoppedAfterOne(Issue130SyntheticTlsProxy.Reply.json(200,refusal()),"REFUSED_SAFE_INCOMPLETE"));
        test("R06_missing_usage_preserved_unknown_STOP",()->{try(Fixture f=new Fixture()){f.network().enqueue(Issue130SyntheticTlsProxy.Reply.json(200,body("CLEAR","0.9",false,0,0)));Map<String,Object> r=f.run();suiteShape(r,1);eq("STOPPED",r.get("status"),"unknown usage stops next");Map<String,Object> c=results(r).get(0);check(c.get("inputTokens")==null&&c.get("outputTokens")==null,"unknown never zero");eq(false,c.get("usageComplete"),"usage incomplete");eq(1,f.proxy.sent.size(),"no next call");String held=Files.readString(f.output.resolve(".suite-consumed.json"));check(held.contains("0.23068672"),"full N16 estimate remains held after unknown usage");}});
        test("R07_partial_usage_keeps_known_input",()->{try(Fixture f=new Fixture()){Map<String,Object> e=map(JSON.readValue(CLEAR,Map.class));e.put("usage",Map.of("input_tokens",137));f.network().enqueue(Issue130SyntheticTlsProxy.Reply.json(200,JSON.writeValueAsString(e)));Map<String,Object> r=f.run();eq("STOPPED",r.get("status"),"partial usage stops");eq(137L,number(results(r).get(0).get("inputTokens")),"known partial input retained");check(results(r).get(0).get("outputTokens")==null,"unknown output not zero");eq(1,f.proxy.sent.size(),"one call");}});
        test("R08_over_proxy_stops_next",()->stoppedAfterOne(Issue130SyntheticTlsProxy.Reply.json(200,body("CLEAR","0.9",true,65537,7)),"STOP_API_OR_CONTRACT_OR_TIMEOUT"));
        test("R09_output2049_not_silently_zeroed",()->{try(Fixture f=new Fixture()){f.replies(body("CLEAR","0.9",true,137,2049));Map<String,Object> r=f.run();suiteShape(r,16);eq("CLEAR_STOP",results(r).get(0).get("outcome"),"Decisions output not legacy B token cap");eq(2049L,number(results(r).get(0).get("outputTokens")),"actual output known");}});
        test("R10_malformed_JSON_STOP",()->stoppedAfterOne(Issue130SyntheticTlsProxy.Reply.json(200,"{bad-json"),"STOP_API_OR_CONTRACT_OR_TIMEOUT"));
        test("R11_wrong_model_STOP",()->stoppedAfterOne(Issue130SyntheticTlsProxy.Reply.json(200,CLEAR.replace("gpt-6-luna","synthetic-other-model")),"STOP_API_OR_CONTRACT_OR_TIMEOUT"));
        test("R12_response_cap_16384",()->stoppedAfterOne(Issue130SyntheticTlsProxy.Reply.json(200,"x".repeat(16385)),"STOP_API_OR_CONTRACT_OR_TIMEOUT"));
        for(int status:List.of(401,402,407,429,503,302,307)){final int code=status;test("R_HTTP_"+code+"_one_attempt_no_followup",()->{Issue130SyntheticTlsProxy.Reply reply=Issue130SyntheticTlsProxy.Reply.json(code,"{}");if(code==503)reply=reply.header("Retry-After","0");if(code==401)reply=reply.header("WWW-Authenticate","Basic realm=synthetic");if(code==407)reply=reply.header("Proxy-Authenticate","Basic realm=synthetic");if(code==302||code==307)reply=reply.header("Location","https://api.openai.com/v1/decisions");stoppedAfterOne(reply,"STOP_API_OR_CONTRACT_OR_TIMEOUT");});}
        test("L01_missing_root_seal_outbound0",()->{try(Fixture f=new Fixture()){rejected(()->f.run(Map.of("OPENAI_API_KEY",KEY)));eq(0,f.network().sent.size(),"missing trust outbound0");}});
        test("L02_wrong_root_seal_outbound0",()->{try(Fixture f=new Fixture()){rejected(()->f.run(Map.of("OPENAI_API_KEY",KEY,"ISSUE130_FROZEN_PLAN_SHA256","0".repeat(64),"ISSUE130_EXECUTE_FROZEN","0".repeat(64))));eq(0,f.network().sent.size(),"wrong trust outbound0");}});
        test("L03_missing_key_outbound0",()->{try(Fixture f=new Fixture()){Map<String,String> env=new HashMap<>(f.environment());env.remove("OPENAI_API_KEY");rejected(()->f.run(env));eq(0,f.network().sent.size(),"no key outbound0");}});
        test("L04_mutated_frozen_wire_outbound0",()->{try(Fixture f=new Fixture()){Files.writeString(Path.of((String)f.records.get(15).get("request_path")),"{}");f.failClosed();}});
        test("L05_rehashed_mutated_prompt_outbound0",()->{try(Fixture f=new Fixture()){Path wire=Path.of((String)f.records.get(0).get("request_path"));Map<String,Object> w=map(JSON.readValue(Files.readAllBytes(wire),Map.class));w.put("questions",List.of());write(wire,w);f.records.get(0).put("request_sha256",sha(wire));f.records.get(0).put("request_bytes",(int)Files.size(wire));write(f.index,Map.of("status","WIRES_PREPARED_NOT_EXECUTION","records",f.records));f.config.put("preparedIndexSha256",sha(f.index));f.seal();f.failClosed();}});
        test("L06_duplicate_case_identity_outbound0",()->{try(Fixture f=new Fixture()){f.records.get(15).put("opaque_call_id",f.records.get(0).get("opaque_call_id"));write(f.index,Map.of("status","WIRES_PREPARED_NOT_EXECUTION","records",f.records));f.config.put("preparedIndexSha256",sha(f.index));f.seal();f.failClosed();}});
        test("L07_case_count_not16_outbound0",()->{try(Fixture f=new Fixture()){write(f.index,Map.of("status","WIRES_PREPARED_NOT_EXECUTION","records",f.records.subList(0,15)));f.config.put("preparedIndexSha256",sha(f.index));f.seal();f.failClosed();}});
        test("L08_source_manifest_tamper_outbound0",()->{try(Fixture f=new Fixture()){Map<String,Object> m=map(f.config.get("sourceManifest"));Files.writeString(Path.of((String)m.get("path")),"{}");f.failClosed();}});
        test("L09_runtime_hash_mismatch_outbound0",()->{try(Fixture f=new Fixture()){Map<String,Object> runtime=new LinkedHashMap<>(map(f.config.get("runtimeFiles")));runtime.put(REPO.resolve(SOURCE_FILES[0]).toString(),"0".repeat(64));f.config.put("runtimeFiles",runtime);f.seal();f.failClosed();}});
        test("L10_missing_cost_outbound0",()->{try(Fixture f=new Fixture()){f.config.remove("costProfile");f.seal();f.failClosed();}});
        for(String field:List.of("inputUsdPerMillion","inputTokenProxy","margin","perCallReservedUsd","priorHeldUsd","maximumNewReservedUsd","maximumCumulativeReservedUsd","approvedAggregateUsd","review")){final String key=field;test("L_COST_null_"+key+"_outbound0",()->{try(Fixture f=new Fixture()){map(f.config.get("costProfile")).put(key,null);f.seal();f.failClosed();}});}
        test("L11_Decimal_ceiling_outbound0",()->{try(Fixture f=new Fixture()){map(f.config.get("costProfile")).put("approvedAggregateUsd","1.56254207");f.seal();f.failClosed();}});
        test("L12_unknown_cost_profile_outbound0",()->{try(Fixture f=new Fixture()){map(f.config.get("costProfile")).put("inputUsdPerMillion","0.11");f.seal();f.failClosed();}});
        test("L13_synthetic_hardcap_claim_rejected",()->{try(Fixture f=new Fixture()){map(f.config.get("costProfile")).put("officialInvoiceHardCapProven",true);f.seal();f.failClosed();}});
        test("L14_repeat_same_suite_zero_extra_calls",()->{try(Fixture f=new Fixture()){f.replies(CLEAR);f.run();rejected(()->f.run());eq(16,f.proxy.sent.size(),"replay cannot redispatch");}});
        test("L15_concurrent_same_suite_atmost16_serial",()->{try(Fixture f=new Fixture()){f.replies(CLEAR);ExecutorService pool=Executors.newFixedThreadPool(2);CountDownLatch start=new CountDownLatch(1);List<Future<Object>> futures=new ArrayList<>();for(int i=0;i<2;i++)futures.add(pool.submit(()->{start.await();try{return f.run();}catch(Issue130RepresentativeDecisionsCli.EvaluationException e){safeCode(e);return "REJECTED";}}));start.countDown();int completed=0;try{for(Future<Object> future:futures){Object value;try{value=future.get(30,TimeUnit.SECONDS);}catch(ExecutionException e){if(e.getCause() instanceof AssertionError a)throw a;throw e;}if(value instanceof Map)completed++;}}finally{pool.shutdownNow();}eq(1,completed,"exactly one suite winner");eq(16,f.proxy.sent.size(),"concurrent suite max16");eq(1,f.proxy.maximumActive.get(),"serial per suite");}});
        test("L16_expired_suite_before_emission_outbound0",()->{try(Fixture f=new Fixture()){AtomicInteger reads=new AtomicInteger();f.nano=()->reads.getAndIncrement()==0?0L:Duration.ofSeconds(301).toNanos();f.network().enqueue(Issue130SyntheticTlsProxy.Reply.json(200,CLEAR));try{Map<String,Object> r=f.run();eq("STOPPED",r.get("status"),"expired suite stops");}catch(Issue130RepresentativeDecisionsCli.EvaluationException e){safeCode(e);}eq(0,f.proxy.sent.size(),"suite startup time counts before emission");}});
        test("L17_slow_body_uses_remaining_case_budget",()->{try(Fixture f=new Fixture()){AtomicLong now=new AtomicLong();AtomicInteger reads=new AtomicInteger();f.nano=()->reads.getAndIncrement()==0?0L:Duration.ofMillis(299850).toNanos();f.network().enqueue(Issue130SyntheticTlsProxy.Reply.json(200,CLEAR).slow(400));Map<String,Object> r=f.run();eq("STOPPED",r.get("status"),"remaining suite timeout includes body");eq("STOP_API_OR_CONTRACT_OR_TIMEOUT",results(r).get(0).get("outcome"),"late response not CLEAR");eq(1,f.proxy.sent.size(),"no retry/next after slow body");}});
        test("L18_backwards_wallclock_no_extra_budget",()->{try(Fixture f=new Fixture()){AtomicInteger reads=new AtomicInteger();f.clock=new Clock(){public ZoneId getZone(){return ZoneOffset.UTC;}public Clock withZone(ZoneId z){return this;}public Instant instant(){return DATE.minusSeconds(reads.getAndIncrement()*1000L);}};f.replies(CLEAR);Map<String,Object> r=f.run();suiteShape(r,16);eq("COMPLETED",r.get("status"),"wallclock does not govern validity");}});
        test("L19_response_persistence_failure_stops_before_next",()->{try(Fixture f=new Fixture()){Files.createDirectory(f.output.resolve("01-response.raw.json"));f.replies(CLEAR);try{Map<String,Object> r=f.run();eq("STOPPED",r.get("status"),"observation persistence failure stops");}catch(Issue130RepresentativeDecisionsCli.EvaluationException e){safeCode(e);}check(f.proxy.sent.size()<=1,"persistence failure no next dispatch");check(Files.isDirectory(f.output.resolve("01-response.raw.json")),"preexisting private path not overwritten");}});
        test("L21_alternate_output_directory_rejected",()->{try(Fixture f=new Fixture()){Path other=Files.createDirectory(f.root.resolve("other-output"));rejected(()->Issue130RepresentativeDecisionsCli.runSuite(f.plan,f.index,other,new Issue130RepresentativeDecisionsCli.Dependencies(f.network().client(),f.nano,f.clock,f.environment())));eq(0,f.proxy.sent.size(),"frozenplan output binding prevents alternate consumption store");}});
        test("L22_output_symlink_ancestor_rejected",()->{try(Fixture f=new Fixture()){Path link=f.root.resolve("alias");Files.createSymbolicLink(link,f.output);f.config.put("outputDirectory",link.toString());f.seal();f.failClosed();}});
        test("L23_missing_remaining_budget_rejected",()->{try(Fixture f=new Fixture()){Map<String,String> env=new HashMap<>(f.environment());env.remove("ISSUE130_SUITE_REMAINING_MILLIS");rejected(()->f.run(env));eq(0,f.network().sent.size(),"remaining startup budget required");}});
        test("L24_zero_remaining_budget_rejected",()->{try(Fixture f=new Fixture()){Map<String,String> env=new HashMap<>(f.environment());env.put("ISSUE130_SUITE_REMAINING_MILLIS","0");rejected(()->f.run(env));eq(0,f.network().sent.size(),"expired startup budget no dispatch");}});
        test("L25_extended_remaining_budget_rejected",()->{try(Fixture f=new Fixture()){Map<String,String> env=new HashMap<>(f.environment());env.put("ISSUE130_SUITE_REMAINING_MILLIS","300001");rejected(()->f.run(env));eq(0,f.network().sent.size(),"wrapper cannot extend300s");}});
        test("L26_late_CLEAR_after_case_deadline_rejected",()->{try(Fixture f=new Fixture()){AtomicLong now=new AtomicLong();f.nano=now::get;f.network().afterRequest=()->now.set(Duration.ofSeconds(16).toNanos());f.network().enqueue(Issue130SyntheticTlsProxy.Reply.json(200,CLEAR));Map<String,Object> r=f.run();eq("STOPPED",r.get("status"),"late valid response stops");eq("STOP_API_OR_CONTRACT_OR_TIMEOUT",results(r).get(0).get("outcome"),"late CLEAR is not accepted");eq(1,f.proxy.sent.size(),"no next case after late response");}});
        test("L27_fresh_preopen_fence_after_validation",()->{try(Fixture f=new Fixture()){AtomicLong now=new AtomicLong();f.nano=now::get;f.clientOverride=f.network().client().newBuilder().addInterceptor(chain->{now.set(Duration.ofSeconds(16).toNanos());return chain.proceed(chain.request());}).build();f.network().enqueue(Issue130SyntheticTlsProxy.Reply.json(200,CLEAR));Map<String,Object> r=f.run();eq("STOPPED",r.get("status"),"expiry immediately before socket stops");eq(0,f.proxy.sent.size(),"fresh preopen fence emits0HTTP");}});
        test("L28_index_gold_field_rejected",()->{try(Fixture f=new Fixture()){Map<String,Object> index=new LinkedHashMap<>();index.put("status","WIRES_PREPARED_NOT_EXECUTION");index.put("records",f.records);index.put("gold","SYNTHETIC_FORBIDDEN_LABEL");write(f.index,index);f.config.put("preparedIndexSha256",sha(f.index));f.seal();f.failClosed();}});
        test("L29_required_production_source_pin_missing",()->{try(Fixture f=new Fixture()){map(f.config.get("runtimeFiles")).remove(REPO.resolve(SOURCE_FILES[1]).toString());f.seal();f.failClosed();}});
        test("L30_wire_byte_count_mismatch_outbound0",()->{try(Fixture f=new Fixture()){f.records.get(15).put("request_bytes",1);write(f.index,Map.of("status","WIRES_PREPARED_NOT_EXECUTION","records",f.records));f.config.put("preparedIndexSha256",sha(f.index));f.seal();f.failClosed();}});
        test("L20_valid_route_disagreement_continues_all16_no_gold",()->{try(Fixture f=new Fixture()){for(int i=0;i<16;i++)f.network().enqueue(Issue130SyntheticTlsProxy.Reply.json(200,body(i%2==0?"CLEAR":"NEEDS_REVIEW","0.9",true,137,7)));Map<String,Object> r=f.run();suiteShape(r,16);eq("COMPLETED",r.get("status"),"no correctness-based/adaptive stop");for(int i=0;i<16;i++)eq(i%2==0?"CLEAR_STOP":"B_REQUIRED_NOT_RUN",results(r).get(i).get("outcome"),"fixed order retained");}});
    }
    static void normalRoute(String raw,String confidence,String assessment,String reason)throws Exception{try(Fixture f=new Fixture()){f.replies(body(raw,confidence,true,137,7));Map<String,Object> r=f.run();suiteShape(r,16);eq("COMPLETED",r.get("status"),"normal uncertainty continues");for(Map<String,Object> c:results(r)){eq("B_REQUIRED_NOT_RUN",c.get("outcome"),"actual generator sentinel reached");eq(raw,c.get("rawChoice"),"raw choice distinct");eq(assessment,c.get("assessment"),"normalized assessment");eq(reason,c.get("reason"),"normalized reason");eq(1L,number(c.get("logicalBProbeEntries")),"one logical B probe");eq(0L,number(c.get("physicalBCalls")),"no B client");}}}
    static void prepareIndex(boolean duplicate)throws Exception{Path root=privateRoot(),index=root.resolve("inputs.json"),output=root.resolve("prepared.json");List<Map<String,Object>> records=new ArrayList<>();for(int i=0;i<16;i++){Path in=root.resolve("in-"+i+".json"),wire=root.resolve("wire-"+i+".json");write(in,input("synthetic independent "+i));records.add(Map.of("opaque_call_id",duplicate&&i==15?"opaque0":"opaque"+i,"canonical_input_sha256",sha(in),"canonical_input_bytes",Files.size(in),"private_input_path",in.toString(),"private_wire_output_path",wire.toString()));}write(index,Map.of("status","INPUTS_FROZEN_WIRE_PREP_NOT_EXECUTION","input_contract",List.of("raw_text","reference_at","time_zone","locale","search_start_date","search_end_date"),"key_network_access_permitted",false,"records",records));if(duplicate){rejected(()->Issue130RepresentativeDecisionsCli.prepareIndex(index,output));check(!Files.exists(output),"invalid index no prepared index");return;}Map<String,Object> r=Issue130RepresentativeDecisionsCli.prepareIndex(index,output);eq(true,r.get("prepared"),"index prepared");eq(16L,number(r.get("caseCount")),"N16");Map<String,Object> prepared=map(JSON.readValue(Files.readAllBytes(output),Map.class));eq("WIRES_PREPARED_NOT_EXECUTION",prepared.get("status"),"not executable identity");List<Map<String,Object>> list=(List<Map<String,Object>>)prepared.get("records");eq(16,list.size(),"N16 exact");for(int i=0;i<16;i++){eq("opaque"+i,list.get(i).get("opaque_call_id"),"order unchanged");eq(Set.of("opaque_call_id","request_path","request_sha256","request_bytes"),list.get(i).keySet(),"no gold/private inputpath");}assertPrivate(output);noLeaks(r);}
    @SuppressWarnings("removal")
    public static void main(String[] args)throws Exception{
        System.setSecurityManager(new Issue130SyntheticNetworkGuard());
        if(args.length==2&&args[0].equals("--export-fixture")){try(Fixture fixture=new Fixture()){write(Path.of(args[1]),Map.of("plan",fixture.plan.toString(),"index",fixture.index.toString(),"output",fixture.output.toString(),"root",fixture.root.toString(),"config",fixture.config));}return;}
        List<String> names=args.length==0?List.copyOf(TESTS.keySet()):List.of(args);int pass=0,fail=0,error=0;
        for(String name:names){Checked body=TESTS.get(name);if(body==null)throw new IllegalArgumentException("UNKNOWN_TEST_ID");try{body.run();pass++;System.out.println(JSON.writeValueAsString(Map.of("test",name,"status","PASS")));}catch(AssertionError e){fail++;System.out.println(JSON.writeValueAsString(Map.of("test",name,"status","ASSERTION_FAILURE","reason",String.valueOf(e.getMessage()).startsWith("TDD RED:")?e.getMessage():"PUBLIC_CONTRACT_ASSERTION")));}catch(Throwable e){error++;System.out.println(JSON.writeValueAsString(Map.of("test",name,"status","SETUP_OR_UNEXPECTED_ERROR","type",e.getClass().getSimpleName())));}}
        System.out.println(JSON.writeValueAsString(Map.of("tests",names.size(),"passed",pass,"assertionFailures",fail,"errors",error,"actualProviderCalls",0,"sealedDataRead",false)));
        if(fail+error!=0)System.exit(1);
    }
}
