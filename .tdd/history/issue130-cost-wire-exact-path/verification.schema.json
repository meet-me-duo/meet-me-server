{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue130 positive synthetic exact-path capsule verification only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workItem",
    "sourceRevision",
    "sourceFiles",
    "capsule",
    "result",
    "limitations",
    "recordedAt"
  ],
  "properties": {
    "workItem": {
      "const": "issue130-cost-wire-exact-path"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "files"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "syntheticCases",
        "syntheticHttpRequests",
        "replayExtraRequests",
        "physicalB",
        "actualProviderCalls",
        "paidCalls",
        "privateCustodyRead",
        "sourceBeforeAfterEqual",
        "sourceInventoryFiles",
        "sourceInventorySha256"
      ],
      "properties": {
        "status": {
          "const": "PASS_SYNTHETIC_EXACT_PATH_DIAGNOSTIC"
        },
        "syntheticCases": {
          "const": 24
        },
        "syntheticHttpRequests": {
          "const": 24
        },
        "replayExtraRequests": {
          "const": 0
        },
        "physicalB": {
          "const": 0
        },
        "actualProviderCalls": {
          "const": 0
        },
        "paidCalls": {
          "const": 0
        },
        "privateCustodyRead": {
          "const": false
        },
        "sourceBeforeAfterEqual": {
          "const": true
        },
        "sourceInventoryFiles": {
          "type": "integer",
          "minimum": 1
        },
        "sourceInventorySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
