{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meet-me.local/schemas/fault-injection-evidence.schema.json",
  "title": "High-risk fault injection evidence summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workItem",
    "sourceRevision",
    "boundary",
    "sourceFiles",
    "testFiles",
    "injections",
    "recordedAt"
  ],
  "properties": {
    "workItem": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    },
    "sourceFiles": {
      "$ref": "#/$defs/files"
    },
    "testFiles": {
      "$ref": "#/$defs/files"
    },
    "injections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fault", "command", "detectedBy", "result"],
        "properties": {
          "fault": { "type": "string", "minLength": 1 },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "detectedBy": { "type": "string", "minLength": 1 },
          "result": { "const": "DETECTED" }
        }
      }
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  },
  "$defs": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
